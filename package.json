{
  "name": "seelyxa-react",
  "version": "1.0.0",
  "description": "seelyxa-react - a Salla React theme",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-local.cjs",
    "clean:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-dev.ps1",
    "clean:cache": "node scripts/clean-cache.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:manifest": "twilight-check-manifest",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:selia": "node scripts/verify-selia.cjs",
    "test:selia": "vitest run tests/components/home/SeliaBlocks.ssr-csr.test.tsx tests/components/home/SeliaAllBlocks.ssr-csr.test.tsx",
    "test:selia:all": "vitest run tests/components/home/SeliaAllBlocks.ssr-csr.test.tsx",
    "audit:design": "node scripts/audit-design-system.cjs",
    "audit:design:detail": "node scripts/audit-design-system.cjs --detail"
  },
  "dependencies": {
    "@salla.sa/twilight-components-react": "^3.0.0-beta.1",
    "@salla.sa/twilight-theme-engine": "^1.0.133",
    "@tanstack/react-query": "~5.102.8",
    "@tanstack/react-router": "~1.170.38",
    "@tanstack/react-router-devtools": "~1.167.2",
    "@tanstack/react-start": "~1.168.57",
    "@tanstack/virtual-file-routes": "~1.162.0",
    "fslightbox": "^3.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@salla.sa/twilight-tailwind-theme": "^3.0.0-beta.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tanstack/react-query-devtools": "~5.102.8",
    "@tanstack/router-plugin": "~1.168.40",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "~6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "esbuild": "0.28.2",
    "jsdom": "^30.0.1",
    "postcss": "8.5.26",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.103.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  }
}
